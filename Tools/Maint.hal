global updating procedure FixPLNamesMn()
begin
  record PLVc PLr;
  record INVc INr;
  
  while(loopmain(PLr,1,true))begin
    INr.Code = PLr.ArtCode;
    if(readfirstmain(INr,1,true))then begin
      if(INr.Name!=PLr.Comment)then begin
        logtext(0,"FixPLNamesMn " & PLr.Comment & " => " & INr.Name);
        PLr.Comment = INr.Name;
        recordstore(PLr,true);
      end;
    end;
  end;

return;
end;

global
updating procedure GitPullHalcustMn(record RcVc RepSpec)
begin
  string 255 script;

  logtext(0,"GitPullHalcustMn");

  script = "bash -c '( ";
  script = script & "cd /usr/local/bin/KNYAZ85/halcust; git pull >> /usr/local/bin/KNYAZ85/hansa.log 2>>/usr/local/bin/KNYAZ85/hansa.log";
  script = script & " )' ";
  RunShellScript(script);

return;
end;