// ==============================================================
// Custom: unique-barcode enforcement, BarcodeVc side.
// Mirrors the check in INVcRecAction.hal — see that file for the full
// rationale, including the zero-padding gotcha both checks now guard
// against. A new barcode variant must not collide with another item's main
// barcode (INVc.BarCode) or another item's variant. Colliding with your OWN
// item's main barcode / other variants is fine (that's the normal "several
// batches, same item" case this register exists for).
// ==============================================================

external function Boolean BarcodeCollides(string,string,var record INVc,var record BarcodeVc,var Boolean);

global
function LongInt BarcodeVcRecordCheck(var record BarcodeVc Barcoder,record BarcodeVc Barcode2r,LongInt stat,LongInt long4)
begin
  LongInt res;
  record INVc dupINr;
  record BarcodeVc dupBCr;
  string 60 rawbarcode;
  Boolean isvariant,collided;

  rawbarcode = Barcoder.Barcode;
  res = inner.BarcodeVcRecordCheck(Barcoder,Barcode2r,stat,long4);

  if(res==0 and nonblank(Barcoder.Barcode))then begin
    collided = BarcodeCollides(Barcoder.Barcode,Barcoder.Itemcode,dupINr,dupBCr,isvariant);
    if(!collided and nonblank(rawbarcode) and rawbarcode!=Barcoder.Barcode)then begin
      collided = BarcodeCollides(rawbarcode,Barcoder.Itemcode,dupINr,dupBCr,isvariant);
    end;
    if(collided)then begin
      if(isvariant)then begin
        RecordCheckError(0,"Штрихкод " & Barcoder.Barcode & " уже присвоен товару " & dupBCr.Itemcode,-1,"Barcode");
      end else begin
        RecordCheckError(0,"Штрихкод " & Barcoder.Barcode & " уже используется как основной у товара " & dupINr.Code & " (" & dupINr.Name & ")",-1,"Barcode");
      end;
      res = -1;
    end;
  end;

  BarcodeVcRecordCheck = res;
  return;
end;
