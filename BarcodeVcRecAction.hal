// ==============================================================
// Custom: unique-barcode enforcement, BarcodeVc side.
// Mirrors the check in INVcRecAction.hal — see that file for the full
// rationale, including why it can't be relied on for webpublic writes
// (RecordCheck hooks aren't reliably invoked outside the GUI save path).
// A new barcode variant must not collide with another item's main barcode
// (INVc.BarCode) or another item's variant. Colliding with your OWN item's
// main barcode / other variants is fine (that's the normal "several
// batches, same item" case this register exists for).
// ==============================================================

external function Boolean FindItemByBarCode(string,string,var string,var string);
external function Boolean FindBarcodeVcByBarcode(string,string,var string);

global
function LongInt BarcodeVcRecordCheck(var record BarcodeVc Barcoder,record BarcodeVc Barcode2r,LongInt stat,LongInt long4)
begin
  LongInt res;
  string 60 dupcode,dupname,dupitemcode;

  res = inner.BarcodeVcRecordCheck(Barcoder,Barcode2r,stat,long4);

  if(res==0 and nonblank(Barcoder.Barcode))then begin
    if(FindItemByBarCode(Barcoder.Barcode,Barcoder.Itemcode,dupcode,dupname))then begin
      RecordCheckError(0,"Штрихкод " & Barcoder.Barcode & " уже используется как основной у товара " & dupcode & " (" & dupname & ")",-1,"Barcode");
      res = -1;
      goto LBarcodeVcRecordCheckCustom;
    end;
    if(FindBarcodeVcByBarcode(Barcoder.Barcode,Barcoder.Itemcode,dupitemcode))then begin
      RecordCheckError(0,"Штрихкод " & Barcoder.Barcode & " уже присвоен товару " & dupitemcode,-1,"Barcode");
      res = -1;
      goto LBarcodeVcRecordCheckCustom;
    end;
  end;

LBarcodeVcRecordCheckCustom:;
  BarcodeVcRecordCheck = res;
  return;
end;
