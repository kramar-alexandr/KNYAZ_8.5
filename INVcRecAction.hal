// ==============================================================
// Custom: unique-barcode enforcement.
// INVc.BarCode is the item's main barcode (fast lookup via the "BarCode" key).
// BarcodeVc holds additional barcode variants for the same item (different
// batches assigned to the same item code) — that's expected and not a
// conflict. What must never happen is the SAME barcode value resolving to
// TWO DIFFERENT items (via either register) — that breaks barcode-scan
// lookup (which item does this scan mean?). This file blocks it going
// forward; WebFindDuplicateBarcodes (halpatch/WebBarcodeAudit.hal) finds
// what already collided before this check existed.
//
// Scan lookup order for any future barcode-scanning integration should be:
// 1) INVc via the "BarCode" key (the main/most common case)
// 2) BarcodeVc via its "Barcode" key (variant/batch barcodes) — only if (1)
//    found nothing, since multiple BarcodeVc rows can share an item on
//    purpose and don't need disambiguating the way a cross-item hit would.
//
// NOTE (found live, 2026-08-26): the RecordCheck hooks below are NOT
// reliably invoked outside the GUI save path — a real conflict slipped
// through RecordUpdate/RecordInsert called from WebSetProductBarcode.hal
// in live testing. That endpoint now checks for a collision itself,
// explicitly, using the two Find* functions below directly — it does not
// depend on these RecordCheck overrides firing at all. Keep this file for
// the GUI path (editing an item/barcode by hand in the ERP client), but
// don't assume it covers webpublic writes.
//
// CALLING CONVENTION (found live, 2026-08-26, root cause of two earlier
// "fixes" that didn't actually work): a function with trailing `var`
// out-parameters called INLINE inside an `if(...)` condition did not
// reliably have those out-parameters populated by the time the `then`
// branch read them — Code/Name/Itemcode kept coming back blank regardless
// of whether the out-param was a whole record or a plain string, even for
// a genuine, real collision (not just the seek-past-end edge case). Base
// HAL master code never does this — it always assigns the call's result to
// a local variable as its own statement first (e.g. ORVcRecAction.hal's
// `errcode = CheckObjs(...); if(errcode!=0)then...`), then checks that
// variable in a separate `if`. Both Find* calls below now follow that same
// two-step form; do NOT change them back to `if(FindX(...))then` — that's
// exactly the form that silently produced blank output params here.
// ==============================================================

global
function Boolean FindItemByBarCode(string barcode,string excludecode,var string foundcode,var string foundname)
begin
  record INVc lINr;
  Boolean found,TrHs;

  found = false;
  lINr.BarCode = barcode;
  TrHs = true;
  while(LoopKey("BarCode",lINr,1,TrHs))begin
    if(lINr.BarCode!=barcode or blank(lINr.Code))then begin
      TrHs = false;
    end else begin
      if(lINr.Code!=excludecode and lINr.Terminated==0)then begin
        found = true;
        foundcode = lINr.Code;
        foundname = lINr.Name;
        TrHs = false;
      end;
    end;
  end;

  FindItemByBarCode = found;
  return;
end;

global
function Boolean FindBarcodeVcByBarcode(string barcode,string excludeitemcode,var string founditemcode)
begin
  record BarcodeVc lBCr;
  Boolean found,TrHs;

  found = false;
  lBCr.Barcode = barcode;
  TrHs = true;
  while(LoopKey("Barcode",lBCr,1,TrHs))begin
    if(lBCr.Barcode!=barcode or blank(lBCr.Itemcode))then begin
      TrHs = false;
    end else begin
      if(lBCr.Itemcode!=excludeitemcode)then begin
        found = true;
        founditemcode = lBCr.Itemcode;
        TrHs = false;
      end;
    end;
  end;

  FindBarcodeVcByBarcode = found;
  return;
end;

global
function LongInt INVcRecordCheck(var record INVc INr,record INVc IN2r,LongInt stat,LongInt long4)
begin
  LongInt res;
  string 60 dupcode,dupname,dupitemcode;
  Boolean collided;

  res = inner.INVcRecordCheck(INr,IN2r,stat,long4);

  if(res==0 and nonblank(INr.BarCode))then begin
    collided = FindItemByBarCode(INr.BarCode,INr.Code,dupcode,dupname);
    if(collided)then begin
      RecordCheckError(0,"Штрихкод " & INr.BarCode & " уже используется товаром " & dupcode & " (" & dupname & ")",-1,"BarCode");
      res = -1;
      goto LINVcRecordCheckCustom;
    end;
    collided = FindBarcodeVcByBarcode(INr.BarCode,INr.Code,dupitemcode);
    if(collided)then begin
      RecordCheckError(0,"Штрихкод " & INr.BarCode & " уже присвоен как дополнительный товару " & dupitemcode,-1,"BarCode");
      res = -1;
      goto LINVcRecordCheckCustom;
    end;
  end;

LINVcRecordCheckCustom:;
  INVcRecordCheck = res;
  return;
end;
