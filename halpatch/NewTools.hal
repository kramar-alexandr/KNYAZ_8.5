updating procedure CopyIVVcToIVOldVcMn(record RcVc RepSpec)
begin
  record IVVc IVr;
  record IVOldVc IVOldr;
  row IVVc IVrw;
  row IVOldVc IVOldrw;
  boolean existsf, testf, TrHs;
  integer i, rwcnt;

