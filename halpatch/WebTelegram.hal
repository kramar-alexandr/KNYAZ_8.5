/*
  Creates and reserves a sales order (ORVc) from the Telegram shop.
  Expected POST JSON:
  {
    "name":"Client Name",
    "phone":"+380501234567",
    "orderid":"12345",
    "items":[
      {"code":"ART001","qty":"2","price":"150.00","discount":"10.00"},
      ...
    ]
  }
  discount is a per-row amount (not a percent) already subtracted from qty*price.
  orderid is the shop admin's order ID - stored in CustOrdNr so re-posting the same
  order is idempotent (returns the existing SerNr instead of duplicating).
  Customer is always NONAME, Location is always SORTIROVOC - client name/phone are just stored on the order header.
  PayDeal is always "PO" (payment terms are mandatory on this order type).
*/
global webpublic updating procedure WebCreateOrderTelegram()
begin
  record ORVc ORr,OR2r;
  row ORVc ORrw;
  record INVc INr;
  area postdata;
  json jsonobj;
  integer i,rwcnt,rownr;
  string 255 custname,custphone,custordnr,artcode,inwarning,warning;
  val qty,price,discount,rowsum;
  boolean chsum,savedf;

  logtext(0,"WebCreateOrderTelegram start");
  WebSetContentType("application/json; charset=UTF-8");
  SetCompany(9,false);

  WebGetRawPostData(postdata);
  WriteAreaToFile(postdata,"WebCreateOrderTelegram.txt",1);
  jsonobj = ParseJSONArea(postdata);

  custname = JSONGet(jsonobj,"name");
  custphone = JSONGet(jsonobj,"phone");
  custordnr = JSONGet(jsonobj,"orderid"); // order ID from the shop admin - kept for sync/dedup

  if(nonblank(custordnr)) then begin
    OR2r.CustOrdNr = custordnr;
    if(ReadFirstKey("CustOrdNr",OR2r,1,true)) then begin
      weboutstring("{\"result\":\"ok\",\"SerNr\":\"" & OR2r.SerNr & "\"}");
      goto LWebCreateOrderTelegramEnd;
    end;
  end;

  RecordNew(ORr);
  ORr.SerNr = NextSerNr("ORVc",ORr.OrdDate,-1,false,"");
  ORr.CustCode = "NONAME";
  ORr.Location = "SORTIROVOC";
  ORr.Addr0 = custname;
  ORr.Phone = custphone;
  ORr.CustOrdNr = custordnr;
  ORr.PayDeal = "PO";

  rwcnt = JSONCountChildren(jsonobj,"items");
  for(i=0;i<rwcnt;i=i+1) begin
    artcode = JSONGet(jsonobj,"items/[" & i & "]/code");
    INr.Code = artcode;
    if(nonblank(artcode) and ReadFirstMain(INr,1,true)) then begin
      qty = StringToVal(JSONGet(jsonobj,"items/[" & i & "]/qty"),M4UVal);
      price = StringToVal(JSONGet(jsonobj,"items/[" & i & "]/price"),M4Val);
      discount = StringToVal(JSONGet(jsonobj,"items/[" & i & "]/discount"),M4Val);
      rowsum = (qty*price) - discount;

      rownr = MatRowCnt(ORr);
      ClearRow(ORr,ORrw,1);
      ORrw.ArtCode = artcode;
      MatRowPut(ORr,rownr,ORrw);
      ORVc_PasteArtCode(ORr,rownr,inwarning,warning,false);
      MatRowGet(ORr,rownr,ORrw);
      ORrw.Quant = qty;
      ORrw.Price = price;
      ORrw.Sum = rowsum;
      MatRowPut(ORr,rownr,ORrw);
      ORVc_PasteSum(ORr,rownr,chsum);
      ORDchsum(ORr,rownr);
    end else begin
      logtext(0,"WebCreateOrderTelegram: unknown item code " & artcode);
    end;
  end;
  ORSumup(ORr);

  ORr.Reserved = 1;

  if(MatRowCnt(ORr)>0) then begin
    savedf = RecordInsert(ORr,true);
  end;

  if(savedf) then begin
    weboutstring("{\"result\":\"ok\",\"SerNr\":\"" & ORr.SerNr & "\"}");
  end else begin
    weboutstring("{\"result\":\"error\"}");
  end;

LWebCreateOrderTelegramEnd:;
  logtext(0,"WebCreateOrderTelegram end");
return;
end;


/*
  Closes a sales order (ORVc) created via WebCreateOrderTelegram.
  Expected POST JSON:
  {
    "SerNr":"93"
  }
  SerNr is the order number returned by WebCreateOrderTelegram.
  Sets Closed=1 via RecordUpdate so the standard save logic releases the reservation.
  Already-closed orders are treated as success (idempotent).
*/
global webpublic updating procedure WebCloseOrderTelegram()
begin
  record ORVc ORr,OldORr;
  area postdata;
  json jsonobj;
  boolean savedf,foundf;
  string 40 rawsernr;
  longint parsedsernr;

  logtext(0,"WebCloseOrderTelegram start");
  WebSetContentType("application/json; charset=UTF-8");
  SetCompany(9,false);

  WebGetRawPostData(postdata);
  jsonobj = ParseJSONArea(postdata);

  rawsernr = JSONGet(jsonobj,"SerNr");
  parsedsernr = stringtolongint(rawsernr);
  logtext(0,"WebCloseOrderTelegram: raw='" & rawsernr & "' parsed=" & parsedsernr);
  ORr.SerNr = parsedsernr;
  foundf = ReadFirstMain(ORr,1,true);
  if(foundf) then begin
    if(ORr.Closed==0) then begin
      RecordCopy(OldORr,ORr);
      ORr.Closed = 1;
      savedf = RecordUpdate(OldORr,ORr,true);
      logtext(0,"WebCloseOrderTelegram: RecordUpdate result " & savedf & " for " & ORr.SerNr);
    end else begin
      savedf = true;
    end;
  end else begin
    logtext(0,"WebCloseOrderTelegram: order not found " & parsedsernr);
  end;

  if(savedf) then begin
    weboutstring("{\"result\":\"ok\",\"SerNr\":\"" & ORr.SerNr & "\"}");
  end else begin
    if(foundf) then begin
      weboutstring("{\"result\":\"error\",\"reason\":\"update_failed\",\"SerNr\":\"" & ORr.SerNr & "\"}");
    end else begin
      weboutstring("{\"result\":\"error\",\"reason\":\"not_found\",\"raw\":\"" & rawsernr & "\",\"parsed\":\"" & parsedsernr & "\"}");
    end;
  end;

  logtext(0,"WebCloseOrderTelegram end");
return;
end;


//http://65.109.135.110:1080/WebPostCreatedIncasationTelegram.hal


global webpublic updating procedure WebPostCreatedIncasationTelegram()
begin
string 50 location,user;
area resarea;
record CLInVc CLInr, OldCLInr;
row CLInVc CLInrw;
record CLOutVc CLOutr,OldCLOutr;
row CLOutVc CLOutrw;
record IVVc IVr;
boolean TrHs,testf;
val sum;
area postdata;
json jsonobj;
record UserVc USr,US2r;
string 100 saler;
	
	logtext(0,"WebPostCreatedIncasationTelegram start");
	  
	  /*
	  
	  {
    "user":"SA",
    "location":"BROVARY",
    "sum":"1000",
}
	  */
		
		WebSetContentType("application/json; charset=UTF-8");	
		SetCompany(9,false);	

		WebGetRawPostData(postdata);
		jsonobj = ParseJSONArea(postdata);
		
		user = JSONGet(jsonobj,"user");
		sum = stringtoval(JSONGet(jsonobj,"sum"),m4val);
		location = JSONGet(jsonobj,"location");
				
		if(sum>0 and nonblank(user) and nonblank(location))then begin
			recordnew(CLOutr);
			USr.Code = location;
			readfirstmain(USr,1,true);
			CLOutr.SerNr = NextSerNr("CLOutVc",currentdate,-1,false,"");
			CLOutr.Person = USr.Code;
			CLOutr.RefStr = user;
			CLOutr.CorspCode = "CASH_OUT";
			CLOutr.Comment = "���������� " & currentdate & " " & user;
			CLOutr.Total = sum;
			CLOutr.NetVal = sum;
			CLOutr.CurncyCode = "UAH";
			CLOutVc_PasteCurncyCode(CLOutr);
			recordinsert(CLOutr,true);
			RecordCopy(OldCLOutr,CLOutr);
			CLOutr.Objects = USr.PersObjx;
			CLOutr.OKFlag = 1;
			if (RecordUpdate(OldCLOutr,CLOutr,true)==0) then begin end;
			
			recordnew(CLInr);
			USr.Code = user;
			readfirstmain(USr,1,true);
			CLInr.SerNr = NextSerNr("CLInVc",currentdate,-1,false,"");
			CLInr.Person = USr.Code;
			CLInr.RefStr = USr.Code;
			CLInr.CorspCode = "CASH_OUT";
			CLInr.Comment = "���������� " & currentdate & " c " & CLOutr.Person;
			CLInr.Total = sum;
			CLInr.CurncyCode = "UAH";
			CLInVc_PasteCurncyCode(CLInr);
			recordinsert(CLInr,true);
			matrowget(CLInr,0,CLInrw);
			RecordCopy(OldCLInr,CLInr);
			CLInr.Objects = USr.PersObjx;
			CLInr.OKFlag = 1;
			if (RecordUpdate(OldCLInr,CLInr,true)==0) then begin end;
			AddTextToArea("{\"result\":\"ok\"}",resarea);
		end else begin
		  AddTextToArea("{\"result\":\"error\"}",resarea);
		end;

		
		weboutarea2(resarea);
	
	
	logtext(0,"WebPostCreatedIncasationTelegram end");
	
return;
end;


/*global webpublic updating procedure WebDeleteLastExpTelegram()
