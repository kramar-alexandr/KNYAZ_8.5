external function string 255 removenextnode(var string);
external procedure addParamToJSONArea(string,string,var area);
external procedure delLastComaInArea(var area);
external function string 255 NormalizeStrToJson(string);
external function roundmode SetRoundModeD(Integer);
external function Boolean ReadFirstItem(string,var record INVc,Boolean,Boolean);
external procedure ExtractObj(string,var Integer,var string);
external outer function Boolean FindItemByBarCode(string,string,var string,var string);
external outer function Boolean FindBarcodeVcByBarcode(string,string,var string);


procedure ShowStandardWebShopItemList()
begin
  record INVc INr;

  while (LoopMain(INr,1,true)) begin
    if (INr.Terminated==0) then begin
      WebOutBegin;
      <?var(INr.Name)?><br>
      EndWebOut;
    end;
  end;

end;

procedure StandardWebShopShoppingCart()
begin
  WebOutBegin;
  <div class="main-cont">
  SHOPPING CART
  </div>
  EndWebOut;
end;

procedure StandardWebShopContactUs()
begin
  WebOutBegin;
  <div class="main-cont">
  CONTACT US
  </div>
  EndWebOut;
end;

procedure StandardWebShopCatalogue()
begin
  WebOutBegin;
  <div class="main-cont">
  EndWebOut;

  ShowStandardWebShopItemList;

  WebOutBegin;
  </div>
  EndWebOut;
end;

procedure StandardWebShopIndexPage()
begin

  WebOutBegin;
  <div class="main-cont">
  INDEX
  </div>
  EndWebOut;

end;

procedure StandardWebShopNavbar()
begin

  WebOutBegin;
  <div class="navbar">
      <div class="nav text">HansaWorld</div>
      <div class="nav button"><a href="/">Main</a></div>
      <div class="nav button"><a href="catalogue">Catalogue</a></div>
      <div class="nav button"><a href="contact">Contact Us</a></div>
      <div class="nav button float-right"><a href="cart"><i class="fas fa-shopping-cart"></i></a></div>
      <div class="nav button float-right"><a href="login">Login</a></div>
      <div class="nav button float-right"><a href="register">Register</a></div>
  </div>
  EndWebOut;

end;

procedure StandardWebShopFooter()
begin

  WebOutBegin;
  <div class="brand-cont">
    <div>Powered by HansaWorld © 2020</div>
  </div>
  EndWebOut;

end;

procedure StandardWebShopHead()
begin

  //TODO add proper heades, will icon and title be set my customer?
  //recommend using company name as title
  WebOutBegin;
  <head>
  <link rel="icon" href="img/favicon.png" sizes="32x32">
  <title>Standard Webshop Demo</title>
  <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.4.1/jquery.min.js"></script>
  <script src="/js/main.js"></script>
  <link rel="stylesheet" type="text/css" href="/css/main.css">
  <script src="/js/font-awesome-kit.js" crossorigin="anonymous"></script>
  </head>
  EndWebOut;

end;

global
procedure StandardWebShopMain(record WebNGStructVc WSr,string mpath)
begin
  string 255 path,node,lang;

  lang="en"; //TODO pull from db
  path = mpath;
  node = removenextnode(path);

  WebOutBegin;
  <html lang="<?var(lang)?>">
  EndWebOut;

  StandardWebShopHead;
  StandardWebShopNavbar;

  WebOutBegin;
  <body>
  EndWebOut;

  switch (node) begin
    case "contact":   StandardWebShopContactUs;
    case "catalogue": StandardWebShopCatalogue;
    case "cart":      StandardWebShopShoppingCart;
    otherwise StandardWebShopIndexPage;
  end;

  StandardWebShopFooter;

  WebOutBegin;
  </body>
  </html>
  EndWebOut;

end;


// ==============================================================
// Custom: Company 9 product catalog export API (token-authenticated)
// Code, Name, all Item Texts (Math array), stock per location
// (skips locations/items with no stock), Price from price list RRP3.
// Optional web arg "artcode" restricts the export to a single item.
// ==============================================================

// Returns the Name of the item's DispGroups entry whose CType matches wantedtype,
// or "" if the item has no DispGroup of that type. INr.DispGroups is a multi-value
// M4UStr field (list of DIVc.Code), unpacked here via ExtractObj.
function string 60 GetItemDispGroupValue(string DispGroups, string wantedtype)
begin
  string 255 s;
  string 60 grp,res;
  integer pos;
  record DIVc DIr;

  res = "";
  s = DispGroups;
  pos = 0;
  ExtractObj(s,pos,grp);
  while(nonblank(grp))begin
    DIr.Code = grp;
    if(ReadFirstMain(DIr,1,true))then begin
      if(DIr.CType==wantedtype)then begin
        res = DIr.Name;
      end;
    end;
    ExtractObj(s,pos,grp);
  end;

  GetItemDispGroupValue = res;
  return;
end;

// Writes a barcodes array (incl. trailing comma) into resarea for one item code,
// under the given JSON key — main barcode first (INVc.BarCode, the "BarCode" key),
// then every batch/variant barcode registered for it in BarcodeVc (the "Itemcode"
// key), skipping an exact repeat. Same lookup order as the record-check in
// INVcRecAction.hal. Defined ahead of its first caller (WriteProductCatalogItem
// below) since it's marked global but still lives in this same file.
global procedure AddItemBarcodesArrayToJSON(string itemcode, string mainbarcode, string keyname, var area resarea)
begin
  record BarcodeVc BCr;
  boolean TrHs;

  AddTextToArea("\"" & keyname & "\":[",resarea);
  if(nonblank(mainbarcode))then begin
    AddTextToArea("\"" & NormalizeStrToJson(mainbarcode) & "\",",resarea);
  end;
  BCr.Itemcode = itemcode;
  TrHs = true;
  while(LoopKey("Itemcode",BCr,1,TrHs))begin
    if(BCr.Itemcode!=itemcode)then begin
      TrHs = false;
    end else begin
      if(nonblank(BCr.Barcode) and BCr.Barcode!=mainbarcode)then begin
        AddTextToArea("\"" & NormalizeStrToJson(BCr.Barcode) & "\",",resarea);
      end;
    end;
  end;
  delLastComaInArea(resarea);
  AddTextToArea("],",resarea);

  return;
end;

// Writes one item's JSON object (incl. trailing comma) into resarea,
// but only if it has available (instock minus reserved) stock somewhere.
procedure WriteProductCatalogItem(record INVc INr, var area resarea)
begin
  record ItemStatusVc ISr;
  record PLVc PLr;
  record ITVc ITr;
  row INVc INrw;
  boolean TrHs,hasstock;
  integer i,rwcnt;
  val price,avail;
  string 60 propval;

  // does the item have available (instock minus reserved) stock in at least one location?
  hasstock = false;
  ISr.Code = INr.Code;
  TrHs = true;
  while(LoopKey("Code",ISr,1,TrHs))begin
    if(ISr.Code!=INr.Code)then begin TrHs = false; end;
    if(TrHs)then begin
      avail = Round(ISr.Instock-ISr.RsrvQty,SetRoundModeD(1));
      if(avail<0)then begin avail = 0; end;
      if(avail!=0)then begin
        hasstock = true;
      end;
    end;
  end;
  ResetLoop(ISr);

  if(hasstock)then begin

    price = blankval;
    PLr.PLCode = "RRP3";
    PLr.ArtCode = INr.Code;
    if(readfirstmain(PLr,2,true))then begin
      price = PLr.ExVatPrice;
    end;

    AddTextToArea("{",resarea);
    addParamToJSONArea("Code",NormalizeStrToJson(INr.Code),resarea);
    if(nonblank(INr.FullName))then begin
      addParamToJSONArea("Name",NormalizeStrToJson(INr.FullName),resarea);
    end else begin
      addParamToJSONArea("Name",NormalizeStrToJson(INr.Name),resarea);
    end;
    addParamToJSONArea("Price",NormalizeStrToJson(price),resarea);
    AddItemBarcodesArrayToJSON(INr.Code,INr.BarCode,"Barcodes",resarea);

    if(nonblank(INr.Group))then begin
      ITr.Code = INr.Group;
      if(ReadFirstMain(ITr,1,true))then begin
        addParamToJSONArea("Group",NormalizeStrToJson(ITr.Comment),resarea);
      end;
    end;

    AddTextToArea("\"Properties\":{",resarea);
    propval = GetItemDispGroupValue(INr.DispGroups,"COLOR");
    if(nonblank(propval))then begin addParamToJSONArea("COLOR",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"FILTER");
    if(nonblank(propval))then begin addParamToJSONArea("FILTER",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"NICOTIN");
    if(nonblank(propval))then begin addParamToJSONArea("NICOTIN",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"SIZE");
    if(nonblank(propval))then begin addParamToJSONArea("SIZE",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"TAR");
    if(nonblank(propval))then begin addParamToJSONArea("TAR",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"TASTE");
    if(nonblank(propval))then begin addParamToJSONArea("TASTE",NormalizeStrToJson(propval),resarea); end;
    delLastComaInArea(resarea);
    AddTextToArea("},",resarea);

    AddTextToArea("\"Descriptions\":[",resarea);
    rwcnt = MatRowCnt(INr);
    for(i=0;i<rwcnt;i=i+1)begin
      MatRowGet(INr,i,INrw);
      if(nonblank(INrw.Text))then begin
        AddTextToArea("{",resarea);
        addParamToJSONArea("LangCode",NormalizeStrToJson(INrw.LangCode),resarea);
        addParamToJSONArea("Text",NormalizeStrToJson(INrw.Text),resarea);
        delLastComaInArea(resarea);
        AddTextToArea("},",resarea);
      end;
    end;
    delLastComaInArea(resarea);
    AddTextToArea("],",resarea);

    AddTextToArea("\"Stock\":[",resarea);
    ISr.Code = INr.Code;
    TrHs = true;
    while(LoopKey("Code",ISr,1,TrHs))begin
      if(ISr.Code!=INr.Code)then begin TrHs = false; end;
      if(TrHs)then begin
        avail = Round(ISr.Instock-ISr.RsrvQty,SetRoundModeD(1));
        if(avail<0)then begin avail = 0; end;
        if(avail!=0)then begin
          AddTextToArea("{",resarea);
          addParamToJSONArea("Location",NormalizeStrToJson(ISr.Location),resarea);
          addParamToJSONArea("Qty",NormalizeStrToJson(avail),resarea);
          delLastComaInArea(resarea);
          AddTextToArea("},",resarea);
        end;
      end;
    end;
    ResetLoop(ISr);
    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);

    AddTextToArea("},",resarea);
  end;

  return;
end;

global webpublic procedure WebGetProductsCatalog()
begin
  string 60 authtoken,artcode;
  record INVc INr;
  area resarea;

  logtext(0,"WebGetProductsCatalog start");

  authtoken = WebGetArg("token");
  artcode = WebGetArg("artcode");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"items\":[",resarea);

    if(nonblank(artcode))then begin
      INr.Code = artcode;
      if(readfirstmain(INr,1,true) and INr.Terminated==0)then begin
        WriteProductCatalogItem(INr,resarea);
      end;
    end else begin
      while(loopmain(INr,1,true))begin
        if(INr.Terminated==0)then begin
          WriteProductCatalogItem(INr,resarea);
        end;
      end;
    end;

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetProductsCatalog unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetProductsCatalog end");

return;
end;


// ==============================================================
// Custom: assign a barcode to a product (token-authenticated), Company 9.
// New barcode goes to INVc.BarCode if the item has no main barcode yet,
// otherwise it's added to BarcodeVc as an additional batch/variant. Already
// having exactly this barcode (as the item's own main or its own variant) is
// treated as success, not an error — the caller doesn't need to check first.
// Uniqueness itself isn't re-implemented here — RecordUpdate/RecordInsert run
// the real checks (INVcRecordCheck/BarcodeVcRecordCheck in INVcRecAction.hal/
// BarcodeVcRecAction.hal) same as any other save, this just surfaces whatever
// RecordCheckError they raised as JSON instead of a UI dialog.
// POST body: {"code":"0006203080250","barcode":"4820000009999"}
// ==============================================================

// NOTE (found live, 2026-08-26): RecordCheck hooks are not reliably invoked
// outside the GUI save path — RecordUpdate/RecordInsert here did NOT run
// INVcRecordCheck/BarcodeVcRecordCheck's uniqueness check (confirmed by a
// live conflict slipping through twice). So this procedure checks for a
// collision itself, explicitly, BEFORE writing anything — it does not rely
// on the record-check hook for that at all anymore. FindItemByBarCode/
// FindBarcodeVcByBarcode (INVcRecAction.hal) are reused here directly.

SetLangMode(LangRussian,"RUS",2);


global webpublic updating procedure WebSetProductBarcode()
begin
  string 60 authtoken;
  area postdata,resarea;
  json jsonobj;
  string 60 code,barcode,dupcode,dupname,dupitemcode;
  record INVc INr,oldINr;
  record BarcodeVc BCr,lBCr;
  boolean TrHs,alreadyowned,savedf,collided;

  logtext(0,"WebSetProductBarcode start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);
    WebGetRawPostData(postdata);
    jsonobj = ParseJSONArea(postdata);

    code = JSONGet(jsonobj,"code");
    barcode = JSONGet(jsonobj,"barcode");

    if(blank(code) or blank(barcode))then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"missing_code_or_barcode\"}",resarea);
      goto LWebSetProductBarcodeEnd;
    end;

    INr.Code = code;
    if(!ReadFirstMain(INr,1,true))then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"item_not_found\"}",resarea);
      goto LWebSetProductBarcodeEnd;
    end;

    if(INr.BarCode==barcode)then begin
      AddTextToArea("{\"result\":\"ok\",\"target\":\"item\"}",resarea);
      goto LWebSetProductBarcodeEnd;
    end;

    // Explicit uniqueness check, own item excluded — this is the actual
    // enforcement now, not the record-check hook (see note above). Called as
    // its own assignment statement, NOT inline inside `if(...)` — calling a
    // function with trailing `var` out-params directly in an if-condition
    // was found live to leave those out-params blank at the call site, even
    // for a genuine match (see INVcRecAction.hal header comment). FindItemByBarCode/
    // FindBarcodeVcByBarcode live at the halcust root (level 3, "outer" relative
    // to halpatch's level 0, see the "external outer" declarations at the top of
    // this file) — declaring them as plain external or external inner both
    // resolved to garbage (found=true, blank output) regardless of input.
    collided = FindItemByBarCode(barcode,code,dupcode,dupname);
    if(collided)then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"" & NormalizeStrToJson("Штрихкод " & barcode & " уже используется товаром " & dupcode & " (" & dupname & ")") & "\"}",resarea);
      goto LWebSetProductBarcodeEnd;
    end;
    collided = FindBarcodeVcByBarcode(barcode,code,dupitemcode);
    if(collided)then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"" & NormalizeStrToJson("Штрихкод " & barcode & " уже присвоен товару " & dupitemcode) & "\"}",resarea);
      goto LWebSetProductBarcodeEnd;
    end;

    if(blank(INr.BarCode))then begin
      RecordCopy(oldINr,INr);
      INr.BarCode = barcode;
      savedf = (RecordUpdate(oldINr,INr,true)==0);
      if(savedf)then begin
        AddTextToArea("{\"result\":\"ok\",\"target\":\"item\"}",resarea);
      end else begin
        AddTextToArea("{\"result\":\"error\",\"error\":\"update_failed\"}",resarea);
      end;
      goto LWebSetProductBarcodeEnd;
    end;

    // Main barcode already taken by this item — only genuinely new for it if
    // it's not already one of its own registered variants (idempotent re-assign).
    // Same LoopKey-past-end guard as FindItemByBarCode/FindBarcodeVcByBarcode
    // (INVcRecAction.hal) — a nonexistent seek target can return a phantom
    // row with blank Itemcode instead of cleanly ending the loop.
    alreadyowned = false;
    lBCr.Barcode = barcode;
    TrHs = true;
    while(LoopKey("Barcode",lBCr,1,TrHs))begin
      if(lBCr.Barcode!=barcode or blank(lBCr.Itemcode))then begin
        TrHs = false;
      end else begin
        if(lBCr.Itemcode==code)then begin
          alreadyowned = true;
          TrHs = false;
        end;
      end;
    end;

    if(alreadyowned)then begin
      AddTextToArea("{\"result\":\"ok\",\"target\":\"variant\"}",resarea);
      goto LWebSetProductBarcodeEnd;
    end;

    RecordNew(BCr);
    BCr.Itemcode = code;
    BCr.Barcode = barcode;
    BCr.Comment = INr.Name;
    savedf = RecordInsert(BCr,true);
    if(savedf)then begin
      AddTextToArea("{\"result\":\"ok\",\"target\":\"variant\"}",resarea);
    end else begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"insert_failed\"}",resarea);
    end;

  end else begin
    logtext(0,"WebSetProductBarcode unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

LWebSetProductBarcodeEnd:;
  weboutarea2(resarea);

  logtext(0,"WebSetProductBarcode end");

return;
end;


// ==============================================================
// Custom: remove a barcode from a product (token-authenticated), Company 9.
// If it's the item's main barcode (INVc.BarCode) — blanks that field. If
// it's a registered variant (BarcodeVc) — deletes that row. Not found on
// this item (main or variant) — error, nothing touched.
// POST body: {"code":"0006203080250","barcode":"4820000009999"}
// ==============================================================

global webpublic updating procedure WebRemoveProductBarcode()
begin
  string 60 authtoken;
  area postdata,resarea;
  json jsonobj;
  string 60 code,barcode;
  record INVc INr,oldINr;
  record BarcodeVc BCr;
  boolean TrHs,found,savedf;

  logtext(0,"WebRemoveProductBarcode start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);
    WebGetRawPostData(postdata);
    jsonobj = ParseJSONArea(postdata);

    code = JSONGet(jsonobj,"code");
    barcode = JSONGet(jsonobj,"barcode");

    if(blank(code) or blank(barcode))then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"missing_code_or_barcode\"}",resarea);
      goto LWebRemoveProductBarcodeEnd;
    end;

    INr.Code = code;
    if(!ReadFirstMain(INr,1,true))then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"item_not_found\"}",resarea);
      goto LWebRemoveProductBarcodeEnd;
    end;

    if(INr.BarCode==barcode)then begin
      RecordCopy(oldINr,INr);
      INr.BarCode = "";
      savedf = (RecordUpdate(oldINr,INr,true)==0);
      if(savedf)then begin
        AddTextToArea("{\"result\":\"ok\",\"target\":\"item\"}",resarea);
      end else begin
        AddTextToArea("{\"result\":\"error\",\"error\":\"update_failed\"}",resarea);
      end;
      goto LWebRemoveProductBarcodeEnd;
    end;

    found = false;
    BCr.Itemcode = code;
    TrHs = true;
    while(LoopKey("Itemcode",BCr,1,TrHs))begin
      if(BCr.Itemcode!=code)then begin
        TrHs = false;
      end else begin
        if(BCr.Barcode==barcode)then begin
          found = true;
          TrHs = false;
        end;
      end;
    end;

    if(!found)then begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"not_found\"}",resarea);
      goto LWebRemoveProductBarcodeEnd;
    end;

    RecordDelete(BCr);
    AddTextToArea("{\"result\":\"ok\",\"target\":\"variant\"}",resarea);

  end else begin
    logtext(0,"WebRemoveProductBarcode unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

LWebRemoveProductBarcodeEnd:;
  weboutarea2(resarea);

  logtext(0,"WebRemoveProductBarcode end");

return;
end;


// ==============================================================
// Custom: Company 9 admins export API (token-authenticated)
// All UserVc with TelIsBoss=1 (and not Closed): Code, Name, Phone1, Phone2.
// ==============================================================

global webpublic procedure WebGetAdmins()
begin
  string 60 authtoken;
  record UserVc USr;
  area resarea;

  logtext(0,"WebGetAdmins start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"admins\":[",resarea);

    while(loopmain(USr,1,true))begin
      if(USr.Closed==0 and (nonblank(USr.Phone1) or nonblank(USr.Phone2)))then begin
        if(USr.TelIsBoss==1 or setinset("MAN",USr.AccessGroup) or setinset("SKLAD",USr.AccessGroup))then begin
          AddTextToArea("{",resarea);
          addParamToJSONArea("Code",NormalizeStrToJson(USr.Code),resarea);
          addParamToJSONArea("Name",NormalizeStrToJson(USr.Name),resarea);
          addParamToJSONArea("Phone1",NormalizeStrToJson(USr.Phone1),resarea);
          addParamToJSONArea("Phone2",NormalizeStrToJson(USr.Phone2),resarea);
          if(USr.TelIsBoss==1)then begin
            addParamToJSONArea("isAdmin","true",resarea);
          end;
          if(setinset("MAN",USr.AccessGroup))then begin
            addParamToJSONArea("isManager","true",resarea);
          end;
          if(setinset("SKLAD",USr.AccessGroup))then begin
            addParamToJSONArea("isWarehouse","true",resarea);
          end;
          delLastComaInArea(resarea);
          AddTextToArea("},",resarea);
        end;
      end;
    end;

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetAdmins unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  writeareatofile(resarea,"hansa.log",1);

  logtext(0,"WebGetAdmins end");

return;
end;


// ==============================================================
// Custom: Company 9 stock transfers export API (token-authenticated)
// StockMovVc from location SORTIROVOC, OKFlag=1 (already confirmed — the
// warehouse just picks/collects), last 3 days — both pending AND already
// assembled/confirmed (ComplFlag=0 or 1, see WebSetStockMovPrinted below),
// with "complFlag" in each movement's JSON so a client can tell them apart
// and reconcile its own local state against the ERP (e.g. a ComplFlag reset
// or manual change made outside the client) instead of only ever seeing
// brand-new ids. Walked backward (newest first) via the FrLocOK key
// (FrLocation+OKFlag+TransDate+SerNr) so we can stop as soon as we pass the
// 3-day window, instead of scanning the whole register.
// ==============================================================

// Writes one movement's JSON object (incl. trailing comma) into resarea.
procedure WriteStockMovementJSON(record StockMovVc SMr, var area resarea)
begin
  record INVc INr;
  row StockMovVc SMrw;
  integer i,rwcnt;

  AddTextToArea("{",resarea);
  addParamToJSONArea("shipmentNo",NormalizeStrToJson(SMr.SerNr),resarea);
  addParamToJSONArea("toLocation",NormalizeStrToJson(SMr.ToLocation),resarea);
  addParamToJSONArea("complFlag",SMr.ComplFlag,resarea);

  AddTextToArea("\"items\":[",resarea);
  rwcnt = MatRowCnt(SMr);
  for(i=0;i<rwcnt;i=i+1)begin
    MatRowGet(SMr,i,SMrw);
    if(nonblank(SMrw.ArtCode) and SMrw.OrdQuant>0)then begin
      ReadFirstItem(SMrw.ArtCode,INr,true,false);
      AddTextToArea("{",resarea);
      addParamToJSONArea("erpId",NormalizeStrToJson(SMrw.ArtCode),resarea);
      addParamToJSONArea("name",NormalizeStrToJson(INr.Name),resarea);
      addParamToJSONArea("qty",NormalizeStrToJson(SMrw.OrdQuant),resarea);
      AddItemBarcodesArrayToJSON(SMrw.ArtCode,INr.BarCode,"barcodes",resarea);
      delLastComaInArea(resarea);
      AddTextToArea("},",resarea);
    end;
  end;
  delLastComaInArea(resarea);
  AddTextToArea("]",resarea);

  AddTextToArea("},",resarea);

  return;
end;

global webpublic procedure WebGetStockMovements()
begin
  string 60 authtoken;
  record StockMovVc SMr;
  area resarea;
  boolean TrHs;

  logtext(0,"WebGetStockMovements start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"movements\":[",resarea);

    SMr.FrLocation = "SORTIROVOC";
    SMr.OKFlag = 1;
    SMr.TransDate = CurrentDate;
    TrHs = true;
    while(LoopBackKey("FrLocOK",SMr,3,TrHs))begin
      if(SMr.FrLocation!="SORTIROVOC")then begin TrHs = false; end;
      if(SMr.OKFlag!=1)then begin TrHs = false; end;
      if(TrHs)then begin
        if(SMr.TransDate<addDay(CurrentDate,-3))then begin
          TrHs = false;
        end else begin
          WriteStockMovementJSON(SMr,resarea);
        end;
      end;
    end;
    ResetLoop(SMr);

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetStockMovements unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetStockMovements end");

return;
end;


// ==============================================================
// Custom: lightweight "what's new" poll for movements (token-authenticated).
// Same selection as WebGetStockMovements above (SORTIROVOC, OKFlag=1, last 3
// days) but only SerNr>sinceId (web arg "sinceId", 0/blank = everything in the
// window), and only enough fields to notify + advance the cursor — no items,
// no barcodes. Built for frequent polling (~15-30s) without re-shipping the
// whole window's payload every time. "maxId" is always the right sinceId to
// pass on the next call, even when "movements" comes back empty — computed
// here instead of left to the caller, since the walk order isn't SerNr order
// (the FrLocOK key sorts by TransDate before SerNr, so a plain "last item
// seen" isn't reliably the max).
// ==============================================================

global webpublic procedure WebGetNewStockMovements()
begin
  string 60 authtoken,sinceidstr;
  record StockMovVc SMr;
  area resarea;
  boolean TrHs;
  LongInt sinceid,maxid;

  logtext(0,"WebGetNewStockMovements start");

  authtoken = WebGetArg("token");
  sinceidstr = WebGetArg("sinceId");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);
    sinceid = stringtolongint(sinceidstr);
    maxid = sinceid;

    AddTextToArea("{",resarea);
    AddTextToArea("\"movements\":[",resarea);

    SMr.FrLocation = "SORTIROVOC";
    SMr.OKFlag = 1;
    SMr.TransDate = CurrentDate;
    TrHs = true;
    while(LoopBackKey("FrLocOK",SMr,3,TrHs))begin
      if(SMr.FrLocation!="SORTIROVOC")then begin TrHs = false; end;
      if(SMr.OKFlag!=1)then begin TrHs = false; end;
      if(TrHs)then begin
        if(SMr.TransDate<addDay(CurrentDate,-3))then begin
          TrHs = false;
        end else begin
          if(SMr.SerNr>sinceid)then begin
            AddTextToArea("{",resarea);
            addParamToJSONArea("shipmentNo",NormalizeStrToJson(SMr.SerNr),resarea);
            addParamToJSONArea("toLocation",NormalizeStrToJson(SMr.ToLocation),resarea);
            delLastComaInArea(resarea);
            AddTextToArea("},",resarea);
            if(SMr.SerNr>maxid)then begin maxid = SMr.SerNr; end;
          end;
        end;
      end;
    end;
    ResetLoop(SMr);

    delLastComaInArea(resarea);
    AddTextToArea("],",resarea);
    addParamToJSONArea("maxId",NormalizeStrToJson(maxid),resarea);
    delLastComaInArea(resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetNewStockMovements unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  weboutarea2(resarea);

  logtext(0,"WebGetNewStockMovements end");

return;
end;


// ==============================================================
// Custom: confirm a stock transfer as sent/assembled.
// Sets PrintedFlag=1 (sent to the warehouse program) and ComplFlag=1
// (assembly confirmed done — WebGetStockMovements/WebGetNewStockMovements
// above both key off it, the latter via each movement's SerNr cursor
// unaffected by this flag) on the given StockMovVc by SerNr (web arg "sernr").
// ==============================================================

global webpublic updating procedure WebSetStockMovPrinted()
begin
  string 60 authtoken;
  string 20 sernrstr;
  record StockMovVc SMr,oldSMr;
  area resarea;

  logtext(0,"WebSetStockMovPrinted start");

  authtoken = WebGetArg("token");
  sernrstr = WebGetArg("sernr");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    SMr.SerNr = stringtolongint(sernrstr);
    if(SMr.SerNr>0 and readfirstmain(SMr,1,true))then begin
      RecordCopy(oldSMr,SMr);
      SMr.PrintedFlag = 1;
      SMr.ComplFlag = 1;
      if(RecordUpdate(oldSMr,SMr,true)==0)then begin
        AddTextToArea("{\"result\":\"ok\"}",resarea);
      end else begin
        AddTextToArea("{\"result\":\"error\",\"error\":\"update_failed\"}",resarea);
      end;
    end else begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"not_found\"}",resarea);
    end;

  end else begin
    logtext(0,"WebSetStockMovPrinted unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  //ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebSetStockMovPrinted end");

return;
end;


// ==============================================================
// Custom: Company 9 shipments export API (token-authenticated)
// Same selection logic as the IVToShipRn report (Report/IVToShipRт.hal):
// confirmed (OKFlag=1) invoices from the last 5 days, seeded/backward via
// the "InvDate" key, excluding walk-in sales (CustCode="NONAME"), restricted
// to the sorting warehouse (Location="SORTIROVOC") — matches WebGetStockMovements'
// FrLocation filter; other locations' shipments aren't this warehouse's job.
// Both pending and already-shipped invoices are included (never gated on
// ShipedFlag) — "shipedFlag" is in each shipment's JSON so a client can tell
// them apart, same reconciliation purpose as WebGetStockMovements' complFlag.
// Header: invoice number + Addr0 (recipient) + shipedFlag. Items: Spec (name) + Quant.
// ==============================================================

// Writes one invoice's shipment JSON object (incl. trailing comma) into resarea.
procedure WriteShipmentJSON(record IVVc IVr, var area resarea)
begin
  row IVVc IVrw;
  integer i,rwcnt;

  AddTextToArea("{",resarea);
  addParamToJSONArea("invoiceNo",NormalizeStrToJson(IVr.SerNr),resarea);
  addParamToJSONArea("recipient",NormalizeStrToJson(IVr.Addr0),resarea);
  addParamToJSONArea("shipedFlag",IVr.ShipedFlag,resarea);

  AddTextToArea("\"items\":[",resarea);
  rwcnt = MatRowCnt(IVr);
  for(i=0;i<rwcnt;i=i+1)begin
    MatRowGet(IVr,i,IVrw);
    if(IVrw.stp==kInvoiceRowTypeNormal)then begin
      AddTextToArea("{",resarea);
      addParamToJSONArea("name",NormalizeStrToJson(IVrw.Spec),resarea);
      addParamToJSONArea("qty",NormalizeStrToJson(IVrw.Quant),resarea);
      delLastComaInArea(resarea);
      AddTextToArea("},",resarea);
    end;
  end;
  delLastComaInArea(resarea);
  AddTextToArea("]",resarea);

  AddTextToArea("},",resarea);

  return;
end;

global webpublic procedure WebGetShipments()
begin
  string 60 authtoken;
  record IVVc IVr;
  record CUVc CUr;
  area resarea;
  boolean TrHs,testf;

  logtext(0,"WebGetShipments start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"shipments\":[",resarea);

    IVr.InvDate = CurrentDate;
    IVr.SerNr = 9999999999;
    TrHs = true;
    while(LoopBackKey("InvDate",IVr,2,TrHs))begin
      testf = true;
      if(IVr.InvDate<addDay(CurrentDate,-5))then begin TrHs = false; testf = false; end;
      if(IVr.OKFlag==0)then begin testf = false; end;
      if(IVr.ShipedFlag==1)then begin testf = false; end;
      
      if(IVr.Location!="SORTIROVOC")then begin testf = false; end;
      CUr.Code = IVr.CustCode;
      readfirstmain(CUr,1,true);
      if(CUr.Code=="NONAME")then begin testf = false; end;

      if(testf)then begin
        WriteShipmentJSON(IVr,resarea);
      end;
    end;
    ResetLoop(IVr);

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetShipments unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetShipments end");

return;
end;


// ==============================================================
// Custom: lightweight "what's new" poll for shipments (token-authenticated).
// Same selection as WebGetShipments above (SORTIROVOC, OKFlag=1, last 5 days,
// excludes CustCode="NONAME") but only SerNr>sinceId (web arg "sinceId",
// 0/blank = everything in the window), and only enough fields to notify +
// advance the cursor. See WebGetNewStockMovements above for why "maxId" is
// computed here rather than left to the caller.
// ==============================================================

global webpublic procedure WebGetNewShipments()
begin
  string 60 authtoken,sinceidstr;
  record IVVc IVr;
  record CUVc CUr;
  area resarea;
  boolean TrHs,testf;
  LongInt sinceid,maxid;

  logtext(0,"WebGetNewShipments start");

  authtoken = WebGetArg("token");
  sinceidstr = WebGetArg("sinceId");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);
    sinceid = stringtolongint(sinceidstr);
    maxid = sinceid;

    AddTextToArea("{",resarea);
    AddTextToArea("\"shipments\":[",resarea);

    IVr.InvDate = CurrentDate;
    IVr.SerNr = 9999999999;
    TrHs = true;
    while(LoopBackKey("InvDate",IVr,2,TrHs))begin
      testf = true;
      if(IVr.InvDate<addDay(CurrentDate,-5))then begin TrHs = false; testf = false; end;
      if(IVr.OKFlag==0)then begin testf = false; end;
      if(IVr.Location!="SORTIROVOC")then begin testf = false; end;
      if(IVr.SerNr<=sinceid)then begin testf = false; end;
      if(testf)then begin
        CUr.Code = IVr.CustCode;
        readfirstmain(CUr,1,true);
        if(CUr.Code!="NONAME")then begin
          AddTextToArea("{",resarea);
          addParamToJSONArea("invoiceNo",NormalizeStrToJson(IVr.SerNr),resarea);
          addParamToJSONArea("recipient",NormalizeStrToJson(IVr.Addr0),resarea);
          delLastComaInArea(resarea);
          AddTextToArea("},",resarea);
          if(IVr.SerNr>maxid)then begin maxid = IVr.SerNr; end;
        end;
      end;
    end;
    ResetLoop(IVr);

    delLastComaInArea(resarea);
    AddTextToArea("],",resarea);
    addParamToJSONArea("maxId",NormalizeStrToJson(maxid),resarea);
    delLastComaInArea(resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetNewShipments unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  weboutarea2(resarea);

  logtext(0,"WebGetNewShipments end");

return;
end;


// ==============================================================
// Custom: mark an invoice as shipped (analogous to WebSetStockMovPrinted).
// Sets ShipedFlag=1 on the given IVVc by SerNr (web arg "invoiceno").
// ==============================================================

global webpublic updating procedure WebSetInvoiceShipped()
begin
  string 60 authtoken;
  string 20 invoicenostr;
  record IVVc IVr,oldIVr;
  area resarea;

  logtext(0,"WebSetInvoiceShipped start");

  authtoken = WebGetArg("token");
  invoicenostr = WebGetArg("sernr");
  logtext(0,"WebSetInvoiceShipped invoiceno=" & invoicenostr);
  logtext(0,"WebSetInvoiceShipped token=" & authtoken);
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    IVr.SerNr = stringtolongint(invoicenostr);
    if(IVr.SerNr>0 and readfirstmain(IVr,1,true))then begin
      RecordCopy(oldIVr,IVr);
      IVr.ShipedFlag = 1;
      recordstore(IVr,true);
      AddTextToArea("{\"result\":\"ok\"}",resarea);
    end else begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"not_found\"}",resarea);
    end;

  end else begin
    logtext(0,"WebSetInvoiceShipped unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  weboutarea2(resarea);

  logtext(0,"WebSetInvoiceShipped end");

return;
end;


// ==============================================================
// Custom: item name normalization/translation feed (token-authenticated)
// WebGetItemNames        - Code, Name, FullName + item card text (Math2,
//                          via LineTextCnt/LineTextGet) for every item.
// WebUpdateItemFullText  - receives back the corrected FullName/Text per
//                          item (JSON body: {"items":[{"Code","FullName","Text"}]}).
//                          FullName is a full replace (send "" to clear it);
//                          Text is only touched when nonblank.
// ==============================================================

global webpublic procedure WebGetItemNames()
begin
  string 60 authtoken;
  record INVc INr;
  area resarea;
  integer j,txtcnt;
  string 255 cardtext;

  logtext(0,"WebGetItemNames start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"items\":[",resarea);

    while(loopmain(INr,1,true))begin
      if(INr.Terminated==0)then begin
        AddTextToArea("{",resarea);
        addParamToJSONArea("Code",NormalizeStrToJson(INr.Code),resarea);
        addParamToJSONArea("Name",NormalizeStrToJson(INr.Name),resarea);
        addParamToJSONArea("FullName",NormalizeStrToJson(INr.FullName),resarea);

        cardtext = "";
        txtcnt = LineTextCnt(INr);
        for(j=0;j<txtcnt;j=j+1)begin
          cardtext = cardtext & LineTextGet(INr,j);
          if(j<txtcnt-1)then begin
            cardtext = cardtext & "\\n";
          end;
        end;
        addParamToJSONArea("Text",NormalizeStrToJson(cardtext),resarea);

        delLastComaInArea(resarea);
        AddTextToArea("},",resarea);
      end;
    end;

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetItemNames unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetItemNames end");

return;
end;

global webpublic updating procedure WebUpdateItemFullText()
begin
  string 60 authtoken;
  area postdata,resarea;
  json jsonobj;
  integer i,rwcnt,updated,failed;
  record INVc INr,oldINr;
  string 60 code;
  string 255 newfullname,newtext;

  logtext(0,"WebUpdateItemFullText start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);
    WebGetRawPostData(postdata);
    jsonobj = ParseJSONArea(postdata);

    updated = 0;
    failed = 0;
    rwcnt = JSONCountChildren(jsonobj,"items");
    for(i=0;i<rwcnt;i=i+1)begin
      code = JSONGet(jsonobj,"items/[" & i & "]/Code");
      if(nonblank(code))then begin
        INr.Code = code;
        if(readfirstmain(INr,1,true))then begin
          RecordCopy(oldINr,INr);

          newfullname = JSONGet(jsonobj,"items/[" & i & "]/FullName");
          INr.FullName = newfullname;

          newtext = JSONGet(jsonobj,"items/[" & i & "]/Text");
          if(nonblank(newtext))then begin
            SetTextField(INr,newtext);
          end;

          if(RecordUpdate(oldINr,INr,true)==0)then begin
            updated = updated + 1;
          end else begin
            logtext(0,"WebUpdateItemFullText update failed for " & code);
            failed = failed + 1;
          end;
        end else begin
          logtext(0,"WebUpdateItemFullText code not found: " & code);
          failed = failed + 1;
        end;
      end;
    end;

    AddTextToArea("{",resarea);
    addParamToJSONArea("result","ok",resarea);
    addParamToJSONArea("updated",updated,resarea);
    addParamToJSONArea("failed",failed,resarea);
    delLastComaInArea(resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebUpdateItemFullText unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  weboutarea2(resarea);

  logtext(0,"WebUpdateItemFullText end");

return;
end;
