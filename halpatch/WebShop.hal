end;

global
procedure StandardWebShopMain(record WebNGStructVc WSr,string mpath)
begin
  string 255 path,node,lang;

  lang="en"; //TODO pull from db
  path = mpath;
  node = removenextnode(path);

  WebOutBegin;
  <html lang="<?var(lang)?>">
  EndWebOut;

  StandardWebShopHead;
  StandardWebShopNavbar;

  WebOutBegin;
  <body>
  EndWebOut;

  switch (node) begin
    case "contact":   StandardWebShopContactUs;
    case "catalogue": StandardWebShopCatalogue;
    case "cart":      StandardWebShopShoppingCart;
    otherwise StandardWebShopIndexPage;
  end;

  StandardWebShopFooter;

  WebOutBegin;
  </body>
  </html>
  EndWebOut;

end;


// ==============================================================
// Custom: Company 9 product catalog export API (token-authenticated)
// Code, Name, all Item Texts (Math array), stock per location
// (skips locations/items with no stock), Price from price list RRP3.
// Optional web arg "artcode" restricts the export to a single item.
// ==============================================================

// Returns the Name of the item's DispGroups entry whose CType matches wantedtype,
// or "" if the item has no DispGroup of that type. INr.DispGroups is a multi-value
// M4UStr field (list of DIVc.Code), unpacked here via ExtractObj.
function string 60 GetItemDispGroupValue(string DispGroups, string wantedtype)
begin
  string 255 s;
  string 60 grp,res;
  integer pos;
  record DIVc DIr;

  res = "";
  s = DispGroups;
  pos = 0;
  ExtractObj(s,pos,grp);
  while(nonblank(grp))begin
    DIr.Code = grp;
    if(ReadFirstMain(DIr,1,true))then begin
      if(DIr.CType==wantedtype)then begin
        res = DIr.Name;
      end;
    end;
    ExtractObj(s,pos,grp);
  end;

  GetItemDispGroupValue = res;
  return;
end;

// Writes one item's JSON object (incl. trailing comma) into resarea,
// but only if it has available (instock minus reserved) stock somewhere.
procedure WriteProductCatalogItem(record INVc INr, var area resarea)
begin
  record ItemStatusVc ISr;
  record PLVc PLr;
  record ITVc ITr;
  row INVc INrw;
  boolean TrHs,hasstock;
  integer i,rwcnt;
  val price,avail;
  string 60 propval;

  // does the item have available (instock minus reserved) stock in at least one location?
  hasstock = false;
  ISr.Code = INr.Code;
  TrHs = true;
  while(LoopKey("Code",ISr,1,TrHs))begin
    if(ISr.Code!=INr.Code)then begin TrHs = false; end;
    if(TrHs)then begin
      avail = Round(ISr.Instock-ISr.RsrvQty,SetRoundModeD(1));
      if(avail<0)then begin avail = 0; end;
      if(avail!=0)then begin
        hasstock = true;
      end;
    end;
  end;
  ResetLoop(ISr);

  if(hasstock)then begin

    price = blankval;
    PLr.PLCode = "RRP3";
    PLr.ArtCode = INr.Code;
    if(readfirstmain(PLr,2,true))then begin
      price = PLr.ExVatPrice;
    end;

    AddTextToArea("{",resarea);
    addParamToJSONArea("Code",NormalizeStrToJson(INr.Code),resarea);
    if(nonblank(INr.FullName))then begin
      addParamToJSONArea("Name",NormalizeStrToJson(INr.FullName),resarea);
    end else begin
      addParamToJSONArea("Name",NormalizeStrToJson(INr.Name),resarea);
    end;
    addParamToJSONArea("Price",NormalizeStrToJson(price),resarea);

    if(nonblank(INr.Group))then begin
      ITr.Code = INr.Group;
      if(ReadFirstMain(ITr,1,true))then begin
        addParamToJSONArea("Group",NormalizeStrToJson(ITr.Comment),resarea);
      end;
    end;

    AddTextToArea("\"Properties\":{",resarea);
    propval = GetItemDispGroupValue(INr.DispGroups,"COLOR");
    if(nonblank(propval))then begin addParamToJSONArea("COLOR",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"FILTER");
    if(nonblank(propval))then begin addParamToJSONArea("FILTER",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"NICOTIN");
    if(nonblank(propval))then begin addParamToJSONArea("NICOTIN",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"SIZE");
    if(nonblank(propval))then begin addParamToJSONArea("SIZE",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"TAR");
    if(nonblank(propval))then begin addParamToJSONArea("TAR",NormalizeStrToJson(propval),resarea); end;
    propval = GetItemDispGroupValue(INr.DispGroups,"TASTE");
    if(nonblank(propval))then begin addParamToJSONArea("TASTE",NormalizeStrToJson(propval),resarea); end;
    delLastComaInArea(resarea);
    AddTextToArea("},",resarea);

    AddTextToArea("\"Descriptions\":[",resarea);
    rwcnt = MatRowCnt(INr);
    for(i=0;i<rwcnt;i=i+1)begin
      MatRowGet(INr,i,INrw);
      if(nonblank(INrw.Text))then begin
        AddTextToArea("{",resarea);
        addParamToJSONArea("LangCode",NormalizeStrToJson(INrw.LangCode),resarea);
        addParamToJSONArea("Text",NormalizeStrToJson(INrw.Text),resarea);
        delLastComaInArea(resarea);
        AddTextToArea("},",resarea);
      end;
    end;
    delLastComaInArea(resarea);
    AddTextToArea("],",resarea);

    AddTextToArea("\"Stock\":[",resarea);
    ISr.Code = INr.Code;
    TrHs = true;
    while(LoopKey("Code",ISr,1,TrHs))begin
      if(ISr.Code!=INr.Code)then begin TrHs = false; end;
      if(TrHs)then begin
        avail = Round(ISr.Instock-ISr.RsrvQty,SetRoundModeD(1));
        if(avail<0)then begin avail = 0; end;
        if(avail!=0)then begin
          AddTextToArea("{",resarea);
          addParamToJSONArea("Location",NormalizeStrToJson(ISr.Location),resarea);
          addParamToJSONArea("Qty",NormalizeStrToJson(avail),resarea);
          delLastComaInArea(resarea);
          AddTextToArea("},",resarea);
        end;
      end;
    end;
    ResetLoop(ISr);
    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);

    AddTextToArea("},",resarea);
  end;

  return;
end;

global webpublic procedure WebGetProductsCatalog()
begin
  string 60 authtoken,artcode;
  record INVc INr;
  area resarea;

  logtext(0,"WebGetProductsCatalog start");

  authtoken = WebGetArg("token");
  artcode = WebGetArg("artcode");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"items\":[",resarea);

    if(nonblank(artcode))then begin
      INr.Code = artcode;
      if(readfirstmain(INr,1,true) and INr.Terminated==0)then begin
        WriteProductCatalogItem(INr,resarea);
      end;
    end else begin
      while(loopmain(INr,1,true))begin
        if(INr.Terminated==0)then begin
          WriteProductCatalogItem(INr,resarea);
        end;
      end;
    end;

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetProductsCatalog unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetProductsCatalog end");

return;
end;


// ==============================================================
// Custom: Company 9 admins export API (token-authenticated)
// All UserVc with TelIsBoss=1 (and not Closed): Code, Name, Phone1, Phone2.
// ==============================================================

global webpublic procedure WebGetAdmins()
begin
  string 60 authtoken;
  record UserVc USr;
  area resarea;

  logtext(0,"WebGetAdmins start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"admins\":[",resarea);

    while(loopmain(USr,1,true))begin
      if(USr.Closed==0 and (nonblank(USr.Phone1) or nonblank(USr.Phone2)))then begin
        if(USr.TelIsBoss==1 or setinset("MAN",USr.AccessGroup) or setinset("SKLAD",USr.AccessGroup))then begin
          AddTextToArea("{",resarea);
          addParamToJSONArea("Code",NormalizeStrToJson(USr.Code),resarea);
          addParamToJSONArea("Name",NormalizeStrToJson(USr.Name),resarea);
          addParamToJSONArea("Phone1",NormalizeStrToJson(USr.Phone1),resarea);
          addParamToJSONArea("Phone2",NormalizeStrToJson(USr.Phone2),resarea);
          if(USr.TelIsBoss==1)then begin
            addParamToJSONArea("isAdmin","true",resarea);
          end;
          if(setinset("MAN",USr.AccessGroup))then begin
            addParamToJSONArea("isManager","true",resarea);
          end;
          if(setinset("SKLAD",USr.AccessGroup))then begin
            addParamToJSONArea("isWarehouse","true",resarea);
          end;
          delLastComaInArea(resarea);
          AddTextToArea("},",resarea);
        end;
      end;
    end;

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetAdmins unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  writeareatofile(resarea,"hansa.log",1);

  logtext(0,"WebGetAdmins end");

return;
end;


// ==============================================================
// Custom: Company 9 pending stock transfers export API (token-authenticated)
// StockMovVc from location SORTIROVOC, OKFlag=1 (already confirmed — the
// warehouse just picks/collects), ComplFlag=0 (not yet assembled/confirmed
// done — see WebSetStockMovPrinted below), last 3 days. Walked backward
// (newest first) via the FrLocOK key (FrLocation+OKFlag+TransDate+SerNr) so
// we can stop as soon as we pass the 3-day window, instead of scanning the
// whole register.
// ==============================================================

// Writes "barcodes":[...] (incl. trailing comma) into resarea for one item code —
// main barcode first (INVc.BarCode, the "BarCode" key), then every batch/variant
// barcode registered for it in BarcodeVc (the "Itemcode" key), skipping an exact
// repeat. Same lookup order as the record-check in RAction/INVcRecAction.hal.
global procedure AddItemBarcodesArrayToJSON(string itemcode, string mainbarcode, var area resarea)
begin
  record BarcodeVc BCr;
  boolean TrHs;

  AddTextToArea("\"barcodes\":[",resarea);
  if(nonblank(mainbarcode))then begin
    AddTextToArea("\"" & NormalizeStrToJson(mainbarcode) & "\",",resarea);
  end;
  BCr.Itemcode = itemcode;
  TrHs = true;
  while(LoopKey("Itemcode",BCr,1,TrHs))begin
    if(BCr.Itemcode!=itemcode)then begin
      TrHs = false;
    end else begin
      if(nonblank(BCr.Barcode) and BCr.Barcode!=mainbarcode)then begin
        AddTextToArea("\"" & NormalizeStrToJson(BCr.Barcode) & "\",",resarea);
      end;
    end;
  end;
  delLastComaInArea(resarea);
  AddTextToArea("],",resarea);

  return;
end;

// Writes one movement's JSON object (incl. trailing comma) into resarea.
procedure WriteStockMovementJSON(record StockMovVc SMr, var area resarea)
begin
  record INVc INr;
  row StockMovVc SMrw;
  integer i,rwcnt;

  AddTextToArea("{",resarea);
  addParamToJSONArea("shipmentNo",NormalizeStrToJson(SMr.SerNr),resarea);
  addParamToJSONArea("toLocation",NormalizeStrToJson(SMr.ToLocation),resarea);

  AddTextToArea("\"items\":[",resarea);
  rwcnt = MatRowCnt(SMr);
  for(i=0;i<rwcnt;i=i+1)begin
    MatRowGet(SMr,i,SMrw);
    if(nonblank(SMrw.ArtCode) and SMrw.OrdQuant>0)then begin
      ReadFirstItem(SMrw.ArtCode,INr,true,false);
      AddTextToArea("{",resarea);
      addParamToJSONArea("erpId",NormalizeStrToJson(SMrw.ArtCode),resarea);
      addParamToJSONArea("name",NormalizeStrToJson(INr.Name),resarea);
      addParamToJSONArea("qty",NormalizeStrToJson(SMrw.OrdQuant),resarea);
      AddItemBarcodesArrayToJSON(SMrw.ArtCode,INr.BarCode,resarea);
      delLastComaInArea(resarea);
      AddTextToArea("},",resarea);
    end;
  end;
  delLastComaInArea(resarea);
  AddTextToArea("]",resarea);

  AddTextToArea("},",resarea);

  return;
end;

global webpublic procedure WebGetStockMovements()
begin
  string 60 authtoken;
  record StockMovVc SMr;
  area resarea;
  boolean TrHs;

  logtext(0,"WebGetStockMovements start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"movements\":[",resarea);

    SMr.FrLocation = "SORTIROVOC";
    SMr.OKFlag = 1;
    SMr.TransDate = CurrentDate;
    TrHs = true;
    while(LoopBackKey("FrLocOK",SMr,3,TrHs))begin
      if(SMr.FrLocation!="SORTIROVOC")then begin TrHs = false; end;
      if(SMr.OKFlag!=1)then begin TrHs = false; end;
      if(TrHs)then begin
        if(SMr.TransDate<addDay(CurrentDate,-3))then begin
          TrHs = false;
        end else begin
          if(SMr.ComplFlag==0)then begin
            WriteStockMovementJSON(SMr,resarea);
          end;
        end;
      end;
    end;
    ResetLoop(SMr);

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetStockMovements unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetStockMovements end");

return;
end;


// ==============================================================
// Custom: confirm a stock transfer as sent/assembled.
// Sets PrintedFlag=1 (sent to the warehouse program) and ComplFlag=1
// (assembly confirmed done — this is what WebGetStockMovements' ComplFlag=0
// filter above checks) on the given StockMovVc by SerNr (web arg "sernr").
// ==============================================================

global webpublic updating procedure WebSetStockMovPrinted()
begin
  string 60 authtoken;
  string 20 sernrstr;
  record StockMovVc SMr,oldSMr;
  area resarea;

  logtext(0,"WebSetStockMovPrinted start");

  authtoken = WebGetArg("token");
  sernrstr = WebGetArg("sernr");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    SMr.SerNr = stringtolongint(sernrstr);
    if(SMr.SerNr>0 and readfirstmain(SMr,1,true))then begin
      RecordCopy(oldSMr,SMr);
      SMr.PrintedFlag = 1;
      SMr.ComplFlag = 1;
      if(RecordUpdate(oldSMr,SMr,true)==0)then begin
        AddTextToArea("{\"result\":\"ok\"}",resarea);
      end else begin
        AddTextToArea("{\"result\":\"error\",\"error\":\"update_failed\"}",resarea);
      end;
    end else begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"not_found\"}",resarea);
    end;

  end else begin
    logtext(0,"WebSetStockMovPrinted unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  //ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebSetStockMovPrinted end");

return;
end;


// ==============================================================
// Custom: Company 9 shipments export API (token-authenticated)
// Same selection logic as the IVToShipRn report (Report/IVToShipRт.hal):
// confirmed (OKFlag=1) invoices from the last 5 days, seeded/backward via
// the "InvDate" key, excluding walk-in sales (CustCode="NONAME"), restricted
// to the sorting warehouse (Location="SORTIROVOC") — matches WebGetStockMovements'
// FrLocation filter; other locations' shipments aren't this warehouse's job.
// Header: invoice number + Addr0 (recipient). Items: Spec (name) + Quant.
// ==============================================================

// Writes one invoice's shipment JSON object (incl. trailing comma) into resarea.
procedure WriteShipmentJSON(record IVVc IVr, var area resarea)
begin
  row IVVc IVrw;
  integer i,rwcnt;

  AddTextToArea("{",resarea);
  addParamToJSONArea("invoiceNo",NormalizeStrToJson(IVr.SerNr),resarea);
  addParamToJSONArea("recipient",NormalizeStrToJson(IVr.Addr0),resarea);

  AddTextToArea("\"items\":[",resarea);
  rwcnt = MatRowCnt(IVr);
  for(i=0;i<rwcnt;i=i+1)begin
    MatRowGet(IVr,i,IVrw);
    if(IVrw.stp==kInvoiceRowTypeNormal)then begin
      AddTextToArea("{",resarea);
      addParamToJSONArea("name",NormalizeStrToJson(IVrw.Spec),resarea);
      addParamToJSONArea("qty",NormalizeStrToJson(IVrw.Quant),resarea);
      delLastComaInArea(resarea);
      AddTextToArea("},",resarea);
    end;
  end;
  delLastComaInArea(resarea);
  AddTextToArea("]",resarea);

  AddTextToArea("},",resarea);

  return;
end;

global webpublic procedure WebGetShipments()
begin
  string 60 authtoken;
  record IVVc IVr;
  record CUVc CUr;
  area resarea;
  boolean TrHs,testf;

  logtext(0,"WebGetShipments start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"shipments\":[",resarea);

    IVr.InvDate = CurrentDate;
    IVr.SerNr = 9999999999;
    TrHs = true;
    while(LoopBackKey("InvDate",IVr,2,TrHs))begin
      testf = true;
      if(IVr.InvDate<addDay(CurrentDate,-5))then begin TrHs = false; testf = false; end;
      if(IVr.OKFlag==0)then begin testf = false; end;
      if(IVr.Location!="SORTIROVOC")then begin testf = false; end;
      CUr.Code = IVr.CustCode;
      readfirstmain(CUr,1,true);
      if(CUr.Code=="NONAME")then begin testf = false; end;

      if(testf)then begin
        WriteShipmentJSON(IVr,resarea);
      end;
    end;
    ResetLoop(IVr);

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetShipments unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetShipments end");

return;
end;


// ==============================================================
// Custom: mark an invoice as shipped (analogous to WebSetStockMovPrinted).
// Sets ShipedFlag=1 on the given IVVc by SerNr (web arg "invoiceno").
// ==============================================================

global webpublic updating procedure WebSetInvoiceShipped()
begin
  string 60 authtoken;
  string 20 invoicenostr;
  record IVVc IVr,oldIVr;
  area resarea;

  logtext(0,"WebSetInvoiceShipped start");

  authtoken = WebGetArg("token");
  invoicenostr = WebGetArg("sernr");
  logtext(0,"WebSetInvoiceShipped invoiceno=" & invoicenostr);
  logtext(0,"WebSetInvoiceShipped token=" & authtoken);
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    IVr.SerNr = stringtolongint(invoicenostr);
    if(IVr.SerNr>0 and readfirstmain(IVr,1,true))then begin
      RecordCopy(oldIVr,IVr);
      IVr.ShipedFlag = 1;
      recordstore(IVr,true);
      AddTextToArea("{\"result\":\"ok\"}",resarea);
    end else begin
      AddTextToArea("{\"result\":\"error\",\"error\":\"not_found\"}",resarea);
    end;

  end else begin
    logtext(0,"WebSetInvoiceShipped unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  weboutarea2(resarea);

  logtext(0,"WebSetInvoiceShipped end");

return;
end;


// ==============================================================
// Custom: item name normalization/translation feed (token-authenticated)
// WebGetItemNames        - Code, Name, FullName + item card text (Math2,
//                          via LineTextCnt/LineTextGet) for every item.
// WebUpdateItemFullText  - receives back the corrected FullName/Text per
//                          item (JSON body: {"items":[{"Code","FullName","Text"}]}).
//                          FullName is a full replace (send "" to clear it);
//                          Text is only touched when nonblank.
// ==============================================================

global webpublic procedure WebGetItemNames()
begin
  string 60 authtoken;
  record INVc INr;
  area resarea;
  integer j,txtcnt;
  string 255 cardtext;

  logtext(0,"WebGetItemNames start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);

    AddTextToArea("{",resarea);
    AddTextToArea("\"items\":[",resarea);

    while(loopmain(INr,1,true))begin
      if(INr.Terminated==0)then begin
        AddTextToArea("{",resarea);
        addParamToJSONArea("Code",NormalizeStrToJson(INr.Code),resarea);
        addParamToJSONArea("Name",NormalizeStrToJson(INr.Name),resarea);
        addParamToJSONArea("FullName",NormalizeStrToJson(INr.FullName),resarea);

        cardtext = "";
        txtcnt = LineTextCnt(INr);
        for(j=0;j<txtcnt;j=j+1)begin
          cardtext = cardtext & LineTextGet(INr,j);
          if(j<txtcnt-1)then begin
            cardtext = cardtext & "\\n";
          end;
        end;
        addParamToJSONArea("Text",NormalizeStrToJson(cardtext),resarea);

        delLastComaInArea(resarea);
        AddTextToArea("},",resarea);
      end;
    end;

    delLastComaInArea(resarea);
    AddTextToArea("]",resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebGetItemNames unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  ADDFILETOAREA("bigblankfile.txt",resarea,false);
  weboutarea2(resarea);

  logtext(0,"WebGetItemNames end");

return;
end;

global webpublic updating procedure WebUpdateItemFullText()
begin
  string 60 authtoken;
  area postdata,resarea;
  json jsonobj;
  integer i,rwcnt,updated,failed;
  record INVc INr,oldINr;
  string 60 code;
  string 255 newfullname,newtext;

  logtext(0,"WebUpdateItemFullText start");

  authtoken = WebGetArg("token");
  WebSetContentType("application/json; charset=UTF-8");

  if(authtoken=="kn9-cat-7f3a91c2e6")then begin

    SetCompany(9,false);
    WebGetRawPostData(postdata);
    jsonobj = ParseJSONArea(postdata);

    updated = 0;
    failed = 0;
    rwcnt = JSONCountChildren(jsonobj,"items");
    for(i=0;i<rwcnt;i=i+1)begin
      code = JSONGet(jsonobj,"items/[" & i & "]/Code");
      if(nonblank(code))then begin
        INr.Code = code;
        if(readfirstmain(INr,1,true))then begin
          RecordCopy(oldINr,INr);

          newfullname = JSONGet(jsonobj,"items/[" & i & "]/FullName");
          INr.FullName = newfullname;

          newtext = JSONGet(jsonobj,"items/[" & i & "]/Text");
          if(nonblank(newtext))then begin
            SetTextField(INr,newtext);
          end;

          if(RecordUpdate(oldINr,INr,true)==0)then begin
            updated = updated + 1;
          end else begin
            logtext(0,"WebUpdateItemFullText update failed for " & code);
            failed = failed + 1;
          end;
        end else begin
          logtext(0,"WebUpdateItemFullText code not found: " & code);
          failed = failed + 1;
        end;
      end;
    end;

    AddTextToArea("{",resarea);
    addParamToJSONArea("result","ok",resarea);
    addParamToJSONArea("updated",updated,resarea);
    addParamToJSONArea("failed",failed,resarea);
    delLastComaInArea(resarea);
    AddTextToArea("}",resarea);

  end else begin
    logtext(0,"WebUpdateItemFullText unauthorized token");
    AddTextToArea("{\"result\":\"error\",\"error\":\"unauthorized\"}",resarea);
  end;

  weboutarea2(resarea);

  logtext(0,"WebUpdateItemFullText end");

return;
end;
